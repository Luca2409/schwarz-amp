---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

/** Quality section (`#quality`) with a heading and one highlighted card, optionally on a background photo. */
interface Props {
  /** Small label above the heading. */
  eyebrow: string;
  title: string;
  /** Heading of the card. */
  cardTitle: string;
  /** Text of the card. */
  cardText: string;
  /** Optional link below the card text, e.g. to the certificates page. */
  link?: { label: string; href: string };
  /** Optional background photo from `src/assets/`. */
  image?: ImageMetadata;
  /** Alt text of the background photo. */
  imageAlt?: string;
}

const { eyebrow, title, cardTitle, cardText, link, image, imageAlt = '' } = Astro.props;
---

<section class:list={['quality-section', { 'section--photo': image }]} id="quality">
  {image && (
    <Image class="section__photo" src={image} alt={imageAlt} widths={[640, 960, 1440, 1920]} sizes="100vw" />
  )}
  <div class="quality-section__inner">
    <div class="section-heading-block">
      <div class="eyebrow eyebrow--dark">{eyebrow}</div>
      <h2 class="section-heading">{title}</h2>
    </div>

    <div class="quality-card">
      <h3>{cardTitle}</h3>
      <p>{cardText}</p>
      {link && <a class="quality-card__link" href={link.href}>{link.label}</a>}
    </div>
  </div>
</section>
