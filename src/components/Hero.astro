---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

/**
 * First section of the home page: full-bleed photo with headline, intro text and two buttons
 * on top, followed by a bar of key facts (certifications, methods).
 */
interface Props {
  /** Small label above the headline. */
  eyebrow: string;
  /** First part of the headline. */
  titlePrefix: string;
  /** Second part of the headline, visually highlighted. */
  titleHighlight: string;
  /** Intro paragraph. */
  text: string;
  /** Hero image from `src/assets/`; loaded eagerly as it's the largest element on the page. */
  image: ImageMetadata;
  /** Alt text of the image. */
  imageLabel: string;
  /** Label of the primary (yellow) button. */
  primaryLabel: string;
  /** Target of the primary button, e.g. `#services`. */
  primaryHref: string;
  /** Label of the secondary button. */
  secondaryLabel: string;
  /** Target of the secondary button, e.g. `#contact`. */
  secondaryHref: string;
  /** Key facts below the photo, e.g. `{ value: 'ISO 9001:2015', label: 'Certified quality management' }`. */
  facts: { value: string; label: string }[];
}

const props = Astro.props;
---

<section class="hero">
  <div class="hero__stage">
    <Image
      class="hero__image"
      src={props.image}
      alt={props.imageLabel}
      widths={[640, 960, 1280, 1920, 2560]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
    />

    <div class="hero__copy">
      <div class="eyebrow eyebrow--dark">{props.eyebrow}</div>

      <h1 class="hero__title">
        {props.titlePrefix}
        <span>{props.titleHighlight}</span>
      </h1>

      <p class="hero__text">{props.text}</p>

      <div class="hero__actions">
        <a class="button button--primary" href={props.primaryHref}>
          {props.primaryLabel}
          <span>→</span>
        </a>

        <a class="button button--secondary" href={props.secondaryHref}>
          {props.secondaryLabel}
        </a>
      </div>
    </div>
  </div>

  {props.facts.length > 0 && (
    <ul class="hero__facts">
      {props.facts.map((fact) => (
        <li class="hero__fact">
          <strong class="hero__fact-value">{fact.value}</strong>
          <span class="hero__fact-label">{fact.label}</span>
        </li>
      ))}
    </ul>
  )}
</section>
