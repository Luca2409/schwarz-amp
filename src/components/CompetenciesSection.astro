---
import type { CollectionEntry } from 'astro:content';
import CompetencyRow from './CompetencyRow.astro';
import { getEntryPath } from '@/lib/content';

/** List of competencies linking to their detail pages (home page and "related" section). */
interface Props {
  eyebrow: string;
  title: string;
  /** Competencies of one language. */
  entries: CollectionEntry<'competencies'>[];
  /** Section id used as anchor; `services` on the home page. */
  id?: string;
  /** White background instead of black, so the home page sections alternate. */
  light?: boolean;
}

const { eyebrow, title, id = 'services', light = false } = Astro.props;
const entries = [...Astro.props.entries].sort(
  (a, b) => a.data.order - b.data.order
);
---

<section class:list={['competencies-section', { 'competencies-section--light': light }]} id={id}>
  <div class="section-heading-block">
    <div class:list={['eyebrow', { 'eyebrow--dark': !light }]}>{eyebrow}</div>
    <h2 class="section-heading">{title}</h2>
  </div>

  <div class="competency-list">
    {entries.map((entry) => (
      <CompetencyRow
        href={getEntryPath(entry)}
        number={entry.data.number}
        title={entry.data.title}
        teaser={entry.data.teaser}
      />
    ))}
  </div>
</section>
